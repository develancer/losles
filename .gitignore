# Meson and Ninja build trees
/build/
/build-*/
/_build/
/meson-build-*/

# Files produced by an accidental in-source Meson setup
/meson-info/
/meson-logs/
/meson-private/
/build.ninja
/.ninja_deps
/.ninja_log
/compile_commands.json

# Compiler, linker, test, and profiling artifacts
*.o
*.obj
*.a
*.so
*.so.*
*.gcda
*.gcno
*.gcov
*.profraw
*.profdata
core
core.*

# Local installation, distribution, and Debian package output
/_install/
/install-root/
/dist/
*.deb
*.ddeb
*.changes
*.buildinfo

# Meson subproject downloads (keep wrap files and checked-in subprojects)
/subprojects/packagecache/

# Editor and desktop clutter
/.cache/
/.clangd/
/.idea/
/.vscode/
.DS_Store
*.bak
*.swp
*.swo
*.tmp
*~
